# ==========================================================
# SMART HIRE — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ==========================================================

# 1. External AI API Keys (Optional — system runs in Smart NLP Fallback mode if empty)
# Get OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Get Gemini key (100% Free): https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=smarthire_db
MYSQL_USER=smarthire_user
MYSQL_PASSWORD=smarthire_password
MYSQL_ROOT_PASSWORD=rootpassword

# 3. Security & JWT
JWT_SECRET=9a4f2c8d7e1b3a5c7e9f2a4b6c8d1e3f5a7c9b2d4e6f8a1c3e5b7d9f2a4b6c8d
JWT_EXPIRATION_MS=86400000

# 4. Server Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173
